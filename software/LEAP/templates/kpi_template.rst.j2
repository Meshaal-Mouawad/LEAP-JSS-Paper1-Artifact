                </a>
                <a href="discovery_report.html#governance-summary" data-nav-key="governance" class="leap-nav-item">
                   <span class="leap-nav-icon"><svg class="leap-nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 11 2 2 4-4"/></svg></span> Governance State
                </a>
             </div>
             <div class="leap-nav-section">
                <div class="leap-nav-section-title">Evidence</div>
                <a href="#source-evidence" onclick="openLeapSourceEvidence(event)" data-nav-key="evidence" class="leap-nav-item">
                   <span class="leap-nav-icon"><svg class="leap-nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><circle cx="10" cy="13" r="2"/><path d="m20 17-1.45-1.45"/></svg></span> Evidence &amp; Lineage
                </a>
             </div>
             <div class="leap-nav-section">
                <div class="leap-nav-section-title">Utilities</div>
                <a href="search.html" data-nav-key="search" class="leap-nav-item">
                   <span class="leap-nav-icon"><svg class="leap-nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span> Search
                </a>
                <a href="genindex.html" data-nav-key="index" class="leap-nav-item">
                   <span class="leap-nav-icon"><svg class="leap-nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></span> Index
