.. raw:: html



   <a class="leap-skip-link" href="#leap-main-content">Skip to dossier content</a>
   <div class="leap-workspace kpi-dossier-workspace">
      <aside class="leap-sidebar-nav">
         <nav class="leap-nav-rail-inner">
            <div class="leap-nav-section">
               <div class="leap-nav-section-title">Workspace</div>
